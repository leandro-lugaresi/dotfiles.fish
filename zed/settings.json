{
  "format_on_save": "on",
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
  },
  "cursor_blink": true,
  "hide_mouse": "never",
  "inlay_hints": {
    "enabled": true,
    "show_parameter_hints": true,
    "show_type_hints": false,
    "show_value_hints": true,
    "show_other_hints": true,
  },
  "tab_size": 2,
  "vim": {
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
  },
  "minimap": {
    "show": "never",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "languages": {
    "Go": {
      "tab_size": 4
    },
    "TypeScript": {
      "tab_size": 2,
      "formatter": { "language_server": { "name": "dprint" } },
    },
    "JSONC": {
      "tab_size": 2,
      "formatter": { "language_server": { "name": "dprint" } },
    },
    "JavaScript": {
      "tab_size": 2,
      "formatter": { "language_server": { "name": "dprint" } },
    },
    "JSON": {
      "tab_size": 2,
      "formatter": { "language_server": { "name": "dprint" } },
    },
  },
  "lsp": {
    "dprint": {
      "binary": {
        "path": "/opt/homebrew/bin/dprint",
        "arguments": ["lsp"],
        "ignore_system_version": false
      }
    }
  },
  "outline_panel": {
    "git_status": true,
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "agent": {
    "button": false,
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "project_panel": {
    "dock": "left",
    "hide_root": true,
    "git_status_indicator": false,
  },
  "git_panel": {
    "button": false,
    "dock": "right",
    "tree_view": false,
  },
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "buffer_font_features": {
    "calt": true,
  },
  "terminal": {
    "dock": "right",
    "font_family": "Hack Nerd Font Mono",
    "shell": "system",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "vim_mode": true,
  "session": {
    "trust_all_worktrees": true,
  },
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
}
