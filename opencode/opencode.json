{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "fff": {
      "type": "local",
      "command": ["fff-mcp"],
      "enabled": true
    }
  },
  "model": "opencode-go/kimi-k2.6",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "auto",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16000
  },
  "watcher": {
    "ignore": [".git/**", "node_modules/**", ".turbo/**", "dist/**", "build/**"]
  },
  "command": {},
  "plugin": ["oh-my-openagent@latest", "./plugins/effect-ts.ts", "./plugins/local-bin-path.ts"]
}
