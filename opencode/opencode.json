{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/kimi-k2.6",
  "small_model": "opencode-go/deepseek-v4-flash",
  "lsp": true,
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      ".turbo/**",
      "dist/**",
      "build/**"
    ]
  },
  "compaction": {
    "auto": true,
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": false
    }
  },
  "plugin": [
    "@plannotator/opencode@latest",
    "oh-my-opencode-slim@2.2.17",
    "./plugins/local-bin-path.ts",
    "./plugins/effect-ts.ts"
  ],
  "agent": {
    "explore": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  },
}
