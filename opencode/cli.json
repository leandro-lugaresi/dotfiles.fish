{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "dark"
  },
  "plugins": [
    "oh-my-opencode-slim"
  ],
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "editor": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true
}
